<rect x="1650" y="1144" width="170" height="32" rx="7" fill="#fff" fill-opacity=".96"/><text x="1810" y="1166" text-anchor="end" class="mono">Y STEP/DIR/EN</text><circle cx="1840" cy="1160" r="7" class="node"/>
<rect x="1650" y="1234" width="170" height="32" rx="7" fill="#fff" fill-opacity=".96"/><text x="1810" y="1256" text-anchor="end" class="mono">Z STEP/DIR/EN</text><circle cx="1840" cy="1250" r="7" class="node"/>

<!-- A250 -->
<text x="2020" y="940" text-anchor="middle" class="name">A250 · XYZ movement</text>

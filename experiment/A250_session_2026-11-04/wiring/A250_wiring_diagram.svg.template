<svg xmlns="http://www.w3.org/2000/svg" width="2200" height="1480" viewBox="0 0 2200 1480" role="img" aria-labelledby="title">
<title id="title">A250 system connections</title>
<defs>
<style>
text{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;fill:#182839}.name{font-size:27px;font-weight:700}.port{font-size:17px;font-weight:650}.small{font-size:14px;font-weight:600}.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:15px;font-weight:650}.card{fill:#fff;stroke:#c9d4dc;stroke-width:2}.line{fill:none;stroke:#394d60;stroke-width:4;stroke-linecap:round;stroke-linejoin:round}.dashed{stroke-dasharray:12 10}.node{fill:#fff;stroke:#394d60;stroke-width:3}.screen{fill:#111821}.screenText{font-size:23px;font-weight:700;fill:#f5f7fa}.screenA{fill:#a3e4c6}.screenB{fill:#d8c5ff}.terminal{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:14px;font-weight:600;fill:#bdffd0}
</style>
<clipPath id="laptopClip"><rect x="80" y="240" width="500" height="340" rx="16"/></clipPath>
<clipPath id="piClip"><rect x="710" y="240" width="580" height="340" rx="16"/></clipPath>
